# 现场安装：cp .env.example .env → 按现场填写
# 纪律（deployment-spec §3）：`.env` 禁止入库（已在根 .gitignore）、禁止写进镜像、禁止进日志

# ---- 必配 ----
# Neo4j 初始密码（≥8 位；后端与 healthcheck 复用同一个值）
NEO4J_PASSWORD=change-me-please

# ---- 生产默认值（§3：私域禁外发，生产不得为 false）----
PRIVATE_DEPLOY_ENABLED=true

# ---- LLM（ADR-0004 接缝 3：OpenAI 兼容；内网客户自备，可空）----
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- 端口（默认即 deployment-spec §2；改这里前に先确认宿主未被占用）----
# 与 compose 内端口一致：backend 8000 / frontend 3000 / Neo4j 7687,7474
# 改端口前先确认宿主未被占用（见 README「本机端口冲突」）
