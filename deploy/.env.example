# 现场安装：cp .env.example .env → 按现场填写
# 纪律（deployment-spec §3）：`.env` 禁止入库（已在根 .gitignore）、禁止写进镜像、禁止进日志

# ---- 必配（**五个都要填**）----
# 【License】Ed25519 验签公钥（base64，由供应商随版本提供）
# ⚠️ 这一行**此前整个模板都漏了**（F-P6X-1，2026-10-10 恢复演练实测）：
#   - `backend/app/core/config.py` 的 `license_public_key` 默认**空**，而注释写死
#     「**留空 = 一律验签失败**」⇒ 不配就是 `LICENSE_INVALID`；
#   - 更隐蔽的是：compose 的 `--env-file` **只做插值、不会自动注入容器**，
#     所以光在本文件里写还不够 —— 必须经 compose 的 `environment:` 白名单送进容器。
#   ⇒ 缺失时**健康检查仍 200**，但**所有业务接口 403**（G-23 拦）⇒ 极易误判为"装好了"。
# ❗ 这是**公钥**不是密钥：不需像口令那样保密，但必须与供应商签发 License 所用的
#    私钥**配对**；换供应商 / 换密钥对 ⇒ 必须同步换这一行。
LICENSE_PUBLIC_KEY=change-me-please

# Neo4j 初始密码（≥8 位；后端与 healthcheck 复用同一个值）
NEO4J_PASSWORD=change-me-please

# **RLS 的两个业务角色口令（P3-A，2026-10-04 起必填）**：
#   - `APP_OWNER_PASSWORD` → `app_owner`：建表 / 跑迁移 / 落策略（**不是**超级用户）
#   - `APP_RLS_PASSWORD`   → `app_rls` ：**应用连库用的就是这个账号**（`NOBYPASSRLS`）
# ⚠️ 为什么不能省：PG 里**超级用户绕过一切 RLS**，而 `POSTGRES_USER` 起出来的正是
#    超级用户 ⇒ 让 backend 用它连库，等于把 RLS 当装饰品，且**没有任何症状**。
#    这两行缺失时 compose 在**解析阶段**就报错（同 `POSTGRES_PASSWORD`），不会静默降级。
# 轮换：改这里再 `docker compose up -d` 即可（`db-init` 每次都会 `ALTER ROLE … PASSWORD`）。
APP_OWNER_PASSWORD=change-me-please
APP_RLS_PASSWORD=change-me-please

# PostgreSQL 密码（DR-B1：2026-10-01 起关系型库一律 PostgreSQL 16.x，不再用 SQLite 作替身）
# ⚠️ **必填且容易漏**：compose 里写作 `${POSTGRES_PASSWORD:?...}`（必填插值）⇒
#    缺失时**连 `docker compose build` 都会报错**，不只是 `up`
#    （实测：`error while interpolating services.postgres.environment.POSTGRES_PASSWORD:
#     required variable POSTGRES_PASSWORD is missing a value`）。
#    2026-10-04 补：此前本文件漏了这一行 ⇒ 照 README 走一遍必然失败。
POSTGRES_PASSWORD=change-me-please

# ---- 生产默认值（§3：私域禁外发，生产不得为 false）----
PRIVATE_DEPLOY_ENABLED=true

# ---- LLM（ADR-0004 接缝 3：OpenAI 兼容；内网客户自备，可空）----
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- 端口（默认即 deployment-spec §2；改端口**前**先确认宿主未被占用）----
# 与 compose 内端口一致：backend 8000 / frontend 3000 / Neo4j 7687,7474
# 改端口前先确认宿主未被占用（见 README「本机端口冲突」）
