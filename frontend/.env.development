# 开发环境配置（APP_ENV=development，next dev 自动加载）
# 注意：本文件会被提交到 Git，只允许存放非敏感配置（NEXT_PUBLIC_ 前缀会打进客户端包）

NEXT_PUBLIC_APP_ENV=development

# 后端服务地址（本地 FastAPI），禁止在代码中硬编码 Base URL
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# dev-only 默认 org_id（联调 10.1.5）：与 backend/.env.development 的
# DEFAULT_ORG_ID 保持一致；改后者必须同步改这里，否则 dev 认证头与后端默认租户错配。
NEXT_PUBLIC_DEV_DEFAULT_ORG_ID=00000000-0000-4000-8000-000000000001

# 契约中大部分端点当前实现状态为 501 NOT_IMPLEMENTED，
# 因此开发环境默认走 Mock；后端就绪后改为 false 即可切换到真实接口。
NEXT_PUBLIC_USE_MOCK=true
