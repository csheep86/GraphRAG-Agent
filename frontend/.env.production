# 生产环境配置（APP_ENV=production，next build / next start 自动加载）
# 注意：本文件会被提交到 Git，只允许存放非敏感配置。
# 任何密钥（API Key / Token / DB 口令）必须通过 GitHub Secrets 或云厂商
# KMS 在构建期注入，绝不允许写在此处。

NEXT_PUBLIC_APP_ENV=production

# 生产后端地址：部署流水线中用真实域名覆盖，此处为占位
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com

# 生产环境必须使用真实接口
NEXT_PUBLIC_USE_MOCK=false
