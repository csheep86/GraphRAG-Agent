# LangExtract MVP 配置模板（DeepSeek，OpenAI 兼容端点）
# 复制为 .env 后填入真实值。.env 与 .env.* 已被仓库根目录 .gitignore 忽略
# （规则来源：CODEBUDDY.md「环境与依赖规则」）。
# 说明：本 MVP 为独立目录 + 独立 uv 虚拟环境，不依赖 backend/。

# DeepSeek API Key（真实密钥只放本地 .env，绝不提交）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek OpenAI 兼容 Base URL（末尾不要带 /chat/completions）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名：deepseek-chat（V3，通用对话/抽取）
DEEPSEEK_MODEL=deepseek-chat
