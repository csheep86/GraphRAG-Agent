# backend/.env.example
# 复制为 .env 后按需修改；.env 与 .env.* 已被 .gitignore 忽略。
# 规则来源：CODEBUDDY.md「环境与依赖规则」。

# 运行环境：development / test / production
APP_ENV=development

# 对外契约版本（写入 openapi.yaml 的 info.version，必须是常量，保证导出可复现）
APP_VERSION=1.3.0

# ---------------------------------------------------------------------------
# 数据库（关系型）
# ---------------------------------------------------------------------------
# SQLite 是 PostgreSQL 的**开发态替身**（不是临时兜底）：字段类型与查询语义以 PG 为准。
# production 下若检测到 sqlite 驱动，服务会**直接启动失败**，禁止静默降级。
# 切换生产 / 需要 RLS 时改为：
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/graphrag
# 并启用行级安全（见 docs/adr/ADR-0003-tenant-isolation-rls.md §3.6）。
DATABASE_URL=sqlite:///./dev.db

# ---------------------------------------------------------------------------
# Neo4j（知识图谱；ADR-0002 一致性）
# ---------------------------------------------------------------------------
# NEO4J_URI      Bolt 连接串。本地 Docker 默认 bolt://localhost:7687；
#                集群 / Aura 用 neo4j+s://<host>（TLS）。改这里即可切环境，不要改代码。
# NEO4J_USER     Neo4j 用户名。默认 neo4j（社区版唯一内置超管账号）。
# NEO4J_PASSWORD 【密钥】明文口令**只允许**出现在本地 .env / .env.development；
#                生产必须经 GitHub Secrets 或云厂商 KMS 注入，禁止提交、禁止写入日志。
# NEO4J_DATABASE 目标数据库名。社区版只有 neo4j；多库（企业版）再改。
# NEO4J_CONNECTION_TIMEOUT_SECONDS 建连 / 查询超时（秒），避免外部依赖挂起请求。
#
# 首次使用需导入图谱数据（三段式写入 + active 版本：
#   uv run python scripts/import_to_neo4j.py --kg-version <版本号>
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# LLM 推理（接缝 3，Sprint 5 批次 A2：原 DEEPSEEK_* 改名为中性 LLM_*）
# ---------------------------------------------------------------------------
# LLM_PROVIDER       接缝 3 切换开关。当前唯一档位 openai_compatible；
#                    内网双轨（本地 vLLM / Ollama）时同样走 openai_compatible，
#                    只改 LLM_BASE_URL 指向本地端点（plan §18.4），不新增档位。
# LLM_API_KEY        【密钥】仅本地明文，生产用 Secrets / KMS。
#                    留空时 Agent 相关端点返回 501，不会静默降级到其他模型。
# LLM_BASE_URL       OpenAI 兼容网关地址；切厂商 / 自建代理时只改这里。
# LLM_MODEL          模型名，如 deepseek-chat。
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# 解析 Provider（接缝 3，Sprint 5 批次 A2）
# ---------------------------------------------------------------------------
# 当前唯一档位 mineru_cloud；内网本地解析通路落地时在此切换（plan §18.4）。
PARSER_PROVIDER=mineru_cloud

# ---------------------------------------------------------------------------
# 处理管线阶段（接缝 4，Sprint 5 批次 A2）
# ---------------------------------------------------------------------------
# 顺序即执行顺序（parse → extract → kg.build → risk.detect）；
# 删除某项 = 停用该阶段；未登记执行体的阶段自动跳过。
PIPELINE_STAGES=["document.parse","document.extract","kg.build","risk.detect"]

# ---------------------------------------------------------------------------
# 抽取 Provider（接缝 3，Sprint 5 批次 B：document.extract 在线抽取）
# ---------------------------------------------------------------------------
# 当前唯一档位 langextract；未支持的档位显式报错，不静默。
EXTRACTION_PROVIDER=langextract
# EXTRACTION_ENGINE 抽取引擎（Sprint 7.0 起，偿 v1.1.0 §6.3 悬空债）：
#   llm  = 真实调用 LLM（经接缝 3 build_chat_model / LLM_* 配置，不新建客户端）。
#          演示与生产用这一档——正则产物不能冒充业务结论。
#   mock = 正则占位器（只出 ORG/PERSON/MONEY/DATE），仅供 CI / 单测零外部依赖跑链路。
# 未知档位服务**显式报错**，绝不静默回退；LLM 调用失败抛 LangextractError 由
# document.extract 的 tenacity 重试，**不会**回落 mock。
EXTRACTION_ENGINE=llm
# chunk 切分上限（字符）。注意：默认 4000 未在 190 页级全量文档上验证过——真机上
# 单 chunk 输出会撞模型输出上限被截断（非法 JSON）；S7.1 演示重抽跑的是 1200。
# 阈值与「输出上限 / 单 chunk 成本」的对应关系待 Sprint 8 裁决（backend/CODEBUDDY.md §4 S7.1-3）。
EXTRACTION_MAX_CHARS_PER_CHUNK=4000
# 单文档实体 / 关系上限（超限按 confidence 降序裁剪）。
# Sprint 7.1 校准：**500 对长文档不够**——按置信度裁剪会把「法定代表人 / 注册地址」
# 这类低密度高价值实体挤掉（真机证据：changes/Sprint7.1/integration-log.md §4.6）。
# 这是**容量护栏**不是疑点阈值；裁剪前后数量都落在 langextract_done 日志里。
EXTRACTION_MAX_ENTITIES_PER_DOC=2000
EXTRACTION_MAX_RELATIONS_PER_DOC=4000
# 抽取 prompt 版本（经 prompt_loader 加载，prompts/ 下必须有同名版本文件）。
# Sprint 7.1 批次 A 起默认 v2：类型枚举参数化 + 新增 LEGAL_PERSON / ADDRESS 与
# LEGAL_REP / REGISTERED_AT（M4 共享法人 / 共享地址疑点的抽取侧前提）。v1 文件保留不动。
EXTRACTION_PROMPT_VERSION=kg_extraction_v2

# ---------------------------------------------------------------------------
# 知识图谱构建（Sprint 5 批次 B：kg.build 三段式写入，ADR-0002 §3.1/§3.2）
# ---------------------------------------------------------------------------
# 每批 UNWIND LOAD 的节点 / 关系数（防内存峰值）。
KG_BUILD_BATCH_SIZE=500
# 版本策略。当前唯一支持 per_org（kg_versions PG 真源；Neo4j 仅冗余镜像）。
KG_VERSION_STRATEGY=per_org

# ---------------------------------------------------------------------------
# Agent fail-closed（ADR-0003 §4，Sprint 5 批次 B）
# ---------------------------------------------------------------------------
# true：active kg_version 子图含跨租户节点时 /agent/query 返回 403 KG_TENANT_LEAK；
# false：仅告警放行（逃生阀，仅供排障）。
AGENT_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# 异步任务（ADR-0001）
# ---------------------------------------------------------------------------
# 解析任务并发上限（asyncio.Semaphore），防止批量上传打爆 CPU / 外部额度。
TASK_PARSE_CONCURRENCY=2

# 外部调用重试（tenacity 指数退避）：总尝试次数 & 首次等待秒数。
TASK_RETRY_MAX_ATTEMPTS=3
TASK_RETRY_INITIAL_SECONDS=1

# ---------------------------------------------------------------------------
# 租户隔离（ADR-0003）
# ---------------------------------------------------------------------------
# 【仅开发可用】允许用 X-Org-Id / X-Actor-Id 请求头充当认证态兜底。
# 生产环境必须为 false：org_id 只能来自 M5 POST /auth/login 签发的 token。
ALLOW_DEV_ORG_HEADER=true
DEFAULT_ORG_ID=00000000-0000-4000-8000-000000000001
DEFAULT_ACTOR_ID=00000000-0000-4000-8000-0000000000aa

# ---------------------------------------------------------------------------
# 上传限制（M1 验收 2 / 3）
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/csv"]

# ---------------------------------------------------------------------------
# 存储抽象层（M1 §4.3 / Sprint 5 批次 A）
# ---------------------------------------------------------------------------
# 本地文件系统后端的根目录（开发态）。对象键布局 {org_id}/{doc_id}/...；
# 生产切 S3 时替换实现类（app.storage），本变量不再被消费。
STORAGE_ROOT=./storage

# ---------------------------------------------------------------------------
# MinerU 云解析（Sprint 5 批次 A：parsing 真实执行；实测口径见
# docs/mineru_cloud_api_spec.md）
# ---------------------------------------------------------------------------
# MINERU_TOKEN 【密钥】仅本地明文，生产用 Secrets / KMS。留空时 PDF 解析
#               任务将 failed（MINERU_ERROR），不会静默跳过。
MINERU_TOKEN=
MINERU_API_BASE=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_REQUEST_TIMEOUT_SECONDS=120
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_POLL_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Prompt 目录（CODEBUDDY.md「Prompt 版本管理规范」）
# 默认取仓库根目录 prompts/；如需覆盖再打开下行
# ---------------------------------------------------------------------------
# PROMPTS_DIR=../prompts

# ---------------------------------------------------------------------------
# CORS（阶段 3.2 前端联调用）
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
