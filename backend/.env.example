# backend/.env.example
# 复制为 .env 后按需修改；.env 与 .env.* 已被 .gitignore 忽略。
# 规则来源：CODEBUDDY.md「环境与依赖规则」。

# 运行环境：development / test / production
APP_ENV=development

# 对外契约版本（写入 openapi.yaml 的 info.version，必须是常量，保证导出可复现）
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 【临时兜底】Sprint 1 仅用于契约验证：SQLite 不支持 RLS。
# Sprint 3 集成 Neo4j + PostgreSQL 时必须切换为：
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/graphrag
# 并启用行级安全（见 docs/adr/ADR-0003-tenant-isolation-rls.md §3.6）。
DATABASE_URL=sqlite:///./dev.db

# ---------------------------------------------------------------------------
# 租户隔离（ADR-0003）
# ---------------------------------------------------------------------------
# 【仅开发可用】允许用 X-Org-Id / X-Actor-Id 请求头充当认证态兜底。
# 生产环境必须为 false：org_id 只能来自 M5 POST /auth/login 签发的 token。
ALLOW_DEV_ORG_HEADER=true
DEFAULT_ORG_ID=00000000-0000-4000-8000-000000000001
DEFAULT_ACTOR_ID=00000000-0000-4000-8000-0000000000aa

# ---------------------------------------------------------------------------
# 上传限制（M1 验收 2 / 3）
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/csv"]

# ---------------------------------------------------------------------------
# Prompt 目录（CODEBUDDY.md「Prompt 版本管理规范」）
# 默认取仓库根目录 prompts/；如需覆盖再打开下行
# ---------------------------------------------------------------------------
# PROMPTS_DIR=../prompts

# ---------------------------------------------------------------------------
# CORS（阶段 3.2 前端联调用）
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
