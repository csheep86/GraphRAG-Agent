# backend/.env.example
# 复制为 .env 后按需修改；.env 与 .env.* 已被 .gitignore 忽略。
# 规则来源：CODEBUDDY.md「环境与依赖规则」。

# 运行环境：development / test / production
APP_ENV=development

# 对外契约版本（写入 openapi.yaml 的 info.version，必须是常量，保证导出可复现）
APP_VERSION=1.6.0

# ---------------------------------------------------------------------------
# 数据库（关系型）
# ---------------------------------------------------------------------------
# **DR-B1 裁决**：开发 / 测试 / 生产一律 PostgreSQL 16.x。
# SQLite **不再是"开发态替身"**——该口径已于 2026-10-01 作废（它会让方言债在
# 「反正只是开发库」的心态下持续累积，即 RK-2 的成因）。
# production 下若检测到 sqlite，服务**直接启动失败**（`app/core/config.py` 的
# `_guard_production_sqlite`，护栏 G-21 的反向守卫），禁止静默降级。
#
# 本地起一个最小 PG：
#   docker run --rm -d -e POSTGRES_USER=graphrag -e POSTGRES_PASSWORD=graphrag \
#              -e POSTGRES_DB=graphrag -p 5432:5432 postgres:16-alpine
#
# 行级安全（RLS）**已启用（2026-10-04，P3-A / DR-B4）**：
#
#   1. 应用必须用**受限角色**（默认 `app_rls`，`NOBYPASSRLS`、非超级用户、非表 owner）。
#      docker 起的 `POSTGRES_USER` 通常是**超级用户** ⇒ 超级用户**绕过一切 RLS**，
#      用它连库等于把 RLS 当装饰品（G-26 判据 4 会把它叫住）。
#   2. 首次使用先建角色 / 受控函数 / 落策略（须一次超级用户连接）：
#        uv run python scripts/init_rls_roles.py \
#          --admin-url postgresql+psycopg://graphrag:graphrag@localhost:5432/graphrag
#      （开发库首次初始化加 `--create-tables`）
#   3. 建表 / 迁移走 **owner**（`app_owner`），业务查询走本串：
#        DATABASE_URL_OWNER=postgresql+psycopg://app_owner:app_owner@localhost:5432/graphrag
#      测试侧另有 `DATABASE_URL_OWNER`，缺省即上面这串（库名 `graphrag_test`）。
#      **P3-D（2026-10-04）起这是真配置**（`Settings.database_url_owner`）：
#      `migrations/env.py` **优先**取它 ⇒ 部署形态下 `alembic upgrade head` 走 owner。
#      缺它时回落到 `DATABASE_URL`（受限角色）⇒ 迁移 DDL 会 `permission denied`
#      ⇒ **部署之后升不了级**（G-26 判据 9 盯住）。DB 迁移脚本同理。
DATABASE_URL_OWNER=postgresql+psycopg://app_owner:app_owner@localhost:5432/graphrag
#   4. 【密钥】默认口令仅供本地 / CI；生产必须经 Secrets / KMS 注入（见脚本的
#      `APP_OWNER_PASSWORD` / `APP_RLS_PASSWORD`）。
DATABASE_URL=postgresql+psycopg://app_rls:app_rls@localhost:5432/graphrag

# compose 里 PG 服务的口令（`deploy/docker-compose.yml` 的 `${POSTGRES_PASSWORD}`）。
# 注意：**容器内**的 backend 用服务名 `postgres` 连接，不走 5432 端口映射，
# 所以改这里只影响 compose 创建的库；本行与上面的 URL 要保持一致。
# 【密钥】仅本地明文；生产必须经 Secrets / KMS 注入，禁止提交。
POSTGRES_PASSWORD=graphrag

# ---------------------------------------------------------------------------
# Neo4j（知识图谱；ADR-0002 一致性）
# ---------------------------------------------------------------------------
# NEO4J_URI      Bolt 连接串。本地 Docker 默认 bolt://localhost:7687；
#                集群 / Aura 用 neo4j+s://<host>（TLS）。改这里即可切环境，不要改代码。
# NEO4J_USER     Neo4j 用户名。默认 neo4j（社区版唯一内置超管账号）。
# NEO4J_PASSWORD 【密钥】明文口令**只允许**出现在本地 .env / .env.development；
#                生产必须经 GitHub Secrets 或云厂商 KMS 注入，禁止提交、禁止写入日志。
# NEO4J_DATABASE 目标数据库名。社区版只有 neo4j；多库（企业版）再改。
# NEO4J_CONNECTION_TIMEOUT_SECONDS 建连 / 查询超时（秒），避免外部依赖挂起请求。
#
# 首次使用需导入图谱数据（三段式写入 + active 版本：
#   uv run python scripts/import_to_neo4j.py --kg-version <版本号>
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# LLM 推理（接缝 3，Sprint 5 批次 A2：原 DEEPSEEK_* 改名为中性 LLM_*）
# ---------------------------------------------------------------------------
# LLM_PROVIDER       接缝 3 切换开关。当前唯一档位 openai_compatible；
#                    内网双轨（本地 vLLM / Ollama）时同样走 openai_compatible，
#                    只改 LLM_BASE_URL 指向本地端点（plan §18.4），不新增档位。
# LLM_API_KEY        【密钥】仅本地明文，生产用 Secrets / KMS。
#                    留空时 Agent 相关端点返回 501，不会静默降级到其他模型。
# LLM_BASE_URL       OpenAI 兼容网关地址；切厂商 / 自建代理时只改这里。
# LLM_MODEL          模型名，如 deepseek-chat。
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# 评测基线 embedding（A1 / L10-A1：C1 图谱增益的 dense top-k 基线侧）
# ---------------------------------------------------------------------------
# EVAL_EMBEDDING_BASE_URL  留空 ⇒ 回落 LLM_BASE_URL（多数网关 chat / embeddings 同源）。
# EVAL_EMBEDDING_API_KEY   留空 ⇒ 回落 LLM_API_KEY。
# EVAL_EMBEDDING_MODEL     **无默认值**：嵌入模型与对话模型必然不同，须显式指定。
#                          未配置时 C1 判据降级为 UNKNOWN（不是 0、不是 PASS）。
# EVAL_BASELINE_TOP_K      基线侧注入条数（32 = 图侧 EVIDENCE_CHUNK_LIMIT）。
#                          ⚠️ 调小 ⇒ 基线被喂更少证据 ⇒ 增益虚高 ⇒ 由
#                          app/evaluation/baseline.py::comparability_error 判红。
EVAL_EMBEDDING_BASE_URL=
EVAL_EMBEDDING_API_KEY=
EVAL_EMBEDDING_MODEL=
EVAL_BASELINE_TOP_K=32

# ---------------------------------------------------------------------------
# 解析 Provider（接缝 3，Sprint 5 批次 A2）
# ---------------------------------------------------------------------------
# 当前唯一档位 mineru_cloud；内网本地解析通路落地时在此切换（plan §18.4）。
PARSER_PROVIDER=mineru_cloud

# ---------------------------------------------------------------------------
# 处理管线阶段（接缝 4，Sprint 5 批次 A2）
# ---------------------------------------------------------------------------
# 顺序即执行顺序（parse → extract → kg.build → risk.detect）；
# 删除某项 = 停用该阶段；未登记执行体的阶段自动跳过。
PIPELINE_STAGES=["document.parse","document.extract","kg.build","risk.detect"]

# ---------------------------------------------------------------------------
# 抽取 Provider（接缝 3，Sprint 5 批次 B：document.extract 在线抽取）
# ---------------------------------------------------------------------------
# 当前唯一档位 langextract；未支持的档位显式报错，不静默。
EXTRACTION_PROVIDER=langextract
# EXTRACTION_ENGINE 抽取引擎（Sprint 7.0 起，偿 v1.1.0 §6.3 悬空债）：
#   llm  = 真实调用 LLM（经接缝 3 build_chat_model / LLM_* 配置，不新建客户端）。
#          演示与生产用这一档——正则产物不能冒充业务结论。
#   mock = 正则占位器（只出 ORG/PERSON/MONEY/DATE），仅供 CI / 单测零外部依赖跑链路。
# 未知档位服务**显式报错**，绝不静默回退；LLM 调用失败抛 LangextractError 由
# document.extract 的 tenacity 重试，**不会**回落 mock。
EXTRACTION_ENGINE=llm
# chunk 切分上限（字符）。注意：默认 4000 未在 190 页级全量文档上验证过——真机上
# 单 chunk 输出会撞模型输出上限被截断（非法 JSON）；S7.1 演示重抽跑的是 1200。
# 阈值与「输出上限 / 单 chunk 成本」的对应关系待 Sprint 8 裁决（backend/CODEBUDDY.md §4 S7.1-3）。
EXTRACTION_MAX_CHARS_PER_CHUNK=4000
# 单文档实体 / 关系上限（超限按 confidence 降序裁剪）。
# Sprint 7.1 校准：**500 对长文档不够**——按置信度裁剪会把「法定代表人 / 注册地址」
# 这类低密度高价值实体挤掉（真机证据：changes/Sprint7.1/integration-log.md §4.6）。
# 这是**容量护栏**不是疑点阈值；裁剪前后数量都落在 langextract_done 日志里。
EXTRACTION_MAX_ENTITIES_PER_DOC=2000
EXTRACTION_MAX_RELATIONS_PER_DOC=4000
# 抽取 prompt 版本（经 prompt_loader 加载，prompts/ 下**必须有同名版本文件**）。
# v1 -> v2：类型枚举参数化 + 新增 LEGAL_PERSON / ADDRESS 与 LEGAL_REP / REGISTERED_AT
#           （M4 共享法人 / 共享地址疑点的抽取侧前提）。
# v2 -> v3：+ **知识时效**（ADR-0005 §4 / §6 L0）——关系带 valid_from / valid_to，
#           并新增 {{document_date}} 作为 R4「不猜值」的兜底源。
# 各版本 .md 文件保留不动；渲染层按模板**声明的占位符**给值，**不按版本号走分支**
# （见 extraction._render_extraction_prompt）⇒ **升降版本只需改这一行**。
#
# ⚠️ 必须与 backend/app/core/config.py 的 extraction_prompt_version 默认值**保持一致**。
#    2026-10-01 实测：代码默认已是 **v3**，而本文件仍滞留 v2 ⇒ 照此处配置会**静默跑 v2**，
#    知识时效特性（valid_from / valid_to）不生效，**且没有任何报错**。改动这两个之一时，
#    记住另一端还藏着一个同步要求。
EXTRACTION_PROMPT_VERSION=kg_extraction_v3

# ---------------------------------------------------------------------------
# 问答引用闸门（Sprint 10 批次 E，用户决策 A；DR-E6 引用可溯源）
# ---------------------------------------------------------------------------
# true：答案里的凭据（实体提及 / 单号 / 数字）必须能在被引 chunk 的原文里**逐字找到**，
#       找不到的引用一律丢弃；全丢 ⇒ 按 no_grounded_evidence 拒答。
# 为什么要它：实测「引用覆盖率 100%」抓不到**归因错**——chunk_id 合法、前缀也对，
#       但那条 chunk 里根本没有答案依据（Q11 答「LV0001 病假」却挂了一条门禁刷卡记录）。
#       这是 F3「引用可溯源」的核心，覆盖率只是它的弱代理指标。
# 置 false 即回到「chunk_id 合法就放行」的旧口径——**只用于 A/B 对照**，不是常态档位。
# 消费点：app/services/agents.py（调用 _grounded_citations）——有消费者，非预留字段。
QA_CITATION_GATE_ENABLED=true

# ---------------------------------------------------------------------------
# 知识图谱构建（Sprint 5 批次 B：kg.build 三段式写入，ADR-0002 §3.1/§3.2）
# ---------------------------------------------------------------------------
# 每批 UNWIND LOAD 的节点 / 关系数（防内存峰值）。
KG_BUILD_BATCH_SIZE=500
# 版本策略。当前唯一支持 per_org（kg_versions PG 真源；Neo4j 仅冗余镜像）。
KG_VERSION_STRATEGY=per_org

# ---------------------------------------------------------------------------
# Agent fail-closed（ADR-0003 §4，Sprint 5 批次 B）
# ---------------------------------------------------------------------------
# true：active kg_version 子图含跨租户节点时 /agent/query 返回 403 KG_TENANT_LEAK；
# false：仅告警放行（逃生阀，仅供排障）。
# ⚠️ 置 false 会让跨租户隔离**降级为 fail-open**（仅告警放行）——这是全系统唯一
#    一个可配置关闭租户隔离的开关。必须同时置 ALLOW_AGENT_FAIL_OPEN=true 显式登记，
#    并完成「登记 + 告知客户 + 落审计」三项（护栏 G-17 / DR-B12 / ADR-0003 §3.7）。
AGENT_FAIL_CLOSED=true
ALLOW_AGENT_FAIL_OPEN=false

# ---------------------------------------------------------------------------
# 异步任务（ADR-0001）
# ---------------------------------------------------------------------------
# 解析任务并发上限（asyncio.Semaphore），防止批量上传打爆 CPU / 外部额度。
TASK_PARSE_CONCURRENCY=2

# 外部调用重试（tenacity 指数退避）：总尝试次数 & 首次等待秒数。
TASK_RETRY_MAX_ATTEMPTS=3
TASK_RETRY_INITIAL_SECONDS=1

# ---------------------------------------------------------------------------
# 租户隔离（ADR-0003）
# ---------------------------------------------------------------------------
# 【仅开发可用】允许用 X-Org-Id / X-Actor-Id 请求头充当认证态兜底。
# 生产环境必须为 false：org_id 只能来自 M5 POST /auth/login 签发的 token。
ALLOW_DEV_ORG_HEADER=true
DEFAULT_ORG_ID=00000000-0000-4000-8000-000000000001
DEFAULT_ACTOR_ID=00000000-0000-4000-8000-0000000000aa

# ---------------------------------------------------------------------------
# 上传限制（M1 验收 2 / 3）
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/csv"]

# ---------------------------------------------------------------------------
# 存储抽象层（M1 §4.3 / Sprint 5 批次 A）
# ---------------------------------------------------------------------------
# 本地文件系统后端的根目录（开发态）。对象键布局 {org_id}/{doc_id}/...；
# 生产切 S3 时替换实现类（app.storage），本变量不再被消费。
STORAGE_ROOT=./storage

# ---------------------------------------------------------------------------
# MinerU 云解析（Sprint 5 批次 A：parsing 真实执行；实测口径见
# docs/mineru_cloud_api_spec.md）
# ---------------------------------------------------------------------------
# MINERU_TOKEN 【密钥】仅本地明文，生产用 Secrets / KMS。留空时 PDF 解析
#               任务将 failed（MINERU_ERROR），不会静默跳过。
MINERU_TOKEN=
MINERU_API_BASE=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_REQUEST_TIMEOUT_SECONDS=120
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_POLL_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Prompt 目录（CODEBUDDY.md「Prompt 版本管理规范」）
# 默认取仓库根目录 prompts/；如需覆盖再打开下行
# ---------------------------------------------------------------------------
# PROMPTS_DIR=../prompts

# ---------------------------------------------------------------------------
# 限流（M5 §3 验收 5 / Sprint 8.1 批次 B：slowapi）
# ---------------------------------------------------------------------------
# 同一 IP 每分钟对同一接口的请求上限；触发时返回 429 RATE_LIMITED +
# Retry-After，并写 audit_log(action=rate_limit.triggered)。
# /api/v1/health 豁免（探针可达 1 次/秒）。唯一消费点 core/limiter.py。
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# 可观测导出（ADR-0004 §3 第 5 条"合规占位"；Sprint 8 批次 E）
# ---------------------------------------------------------------------------
# 统一日志平台 / OTLP 导出开关。Demo-MVP 阶段**未实现**：置 true 时服务启动即
# 显式报 501 NOT_IMPLEMENTED（不是静默无效）。唯一消费点 core/logging.py。
LOG_EXPORT=false

# ---------------------------------------------------------------------------
# 评测准入线（TBD-7 / DR-D10；P0-m6-eval 批次 E3 落地）
# ---------------------------------------------------------------------------
# C3-a「单文档成本」上限，单位 = **token / 文档**（不是元）。
# 默认值 32 000 是**演示语料推算的 provisional 值，不是达标线**：
#   1799 token/次抽取 × ≈13 chunk/文档 × 1.35 余量 ⇒ 约 23.4k ⇒ 取整 32 000。
# ⚠️ TBD-7 正式收敛在 P6，须先跑校准（只输出建议值、不改本文件）：
#     uv run python scripts/eval_acceptance.py --calibrate --cost-records <file.json>
#    未校准前，C3-a 判定只给 PASS(provisional)，**不构成 TBD-7 收敛证据**。
# ⚠️ chunk 数一律读 backend/data/eval/MANIFEST.json（当前值单一真源=224）。
#    scripts/eval_controlled_qset.py 注释里的 230 是 2026-09-30 的历史值，不可当分母。
# 唯一消费点：app/evaluation/runner.py::resolve_cost_ceiling + eval_acceptance.py。
EVAL_SINGLE_DOC_TOKEN_CEILING=32000

# ---------------------------------------------------------------------------
# CORS（阶段 3.2 前端联调用）
# ---------------------------------------------------------------------------
# 演示环境两种访问方式都要通：localhost 与 127.0.0.1 都要列。
# 只列 localhost 会导致从 http://127.0.0.1:3000 打开前端时预检被拒（Disallowed CORS origin），
# 工作台数据全空。
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
