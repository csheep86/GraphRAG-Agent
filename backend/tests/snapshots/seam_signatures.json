        "params": [
          {
            "annotation": "Settings",
            "default": null,
            "kind": "KEYWORD_ONLY",
            "name": "settings"
          },
          {
            "annotation": "str | None",
            "default": null,
            "kind": "KEYWORD_ONLY",
            "name": "bearer_token"
          },
          {
            "annotation": "str | None",
            "default": null,
            "kind": "KEYWORD_ONLY",
            "name": "org_id_header"
          },
          {
            "annotation": "str | None",
            "default": null,
            "kind": "KEYWORD_ONLY",
            "name": "actor_id_header"
          }
        ],
        "return": "Identity | None"
      }
    },
    "app.services.events.base.EventSink": {
