# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# 环境变量文件：默认全部忽略
.env
.env.*
!.env.example

# 仅放行 frontend 目录下的「不含密钥」的环境模板
# 注意：backend/.env.* 一律保持忽略（含 DeepSeek API Key）
!frontend/.env.development
!frontend/.env.production
!frontend/.env.local.example

# 本地覆盖文件必须忽略（含 .env.local / .env.local.* 变体）
**/.env.local
**/.env.local.*
!frontend/.env.local.example

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 项目特定
uploads/

# 演示用年报 PDF（本机素材，约 47MB，不入库；来源与 STEP-BY-STEP 用法见 changes/Sprint7.0/demo-docs-checklist.md）
docs/annualreport/
**/output/*
*.log

# 存储抽象层根目录（开发环境本地 FS 落盘内容，绝不入库）
backend/storage/

# 系统文件
.DS_Store
Thumbs.db

# 例外：保留 MVP 输出目录的占位文件
!**/output/.gitkeep

# CodeBuddy 临时计划文件
.codebuddy/plans/

# 本地开发数据库（Sprint 1 SQLite 兜底，绝不入库）
*.db
*.db-journal