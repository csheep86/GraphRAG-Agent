# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# 环境变量文件：默认全部忽略
.env
.env.*
!.env.example

# 仅放行 frontend 目录下的「不含密钥」的环境模板
# 注意：backend/.env.* 一律保持忽略（含 DeepSeek API Key）
!frontend/.env.development
!frontend/.env.production
!frontend/.env.local.example

# 本地覆盖文件必须忽略（含 .env.local / .env.local.* 变体）
**/.env.local
**/.env.local.*
!frontend/.env.local.example

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 项目特定
uploads/

# 运行产物：ADR-0005 §4 增补的「条款→文档作用域」共享登记册（R4-b 兜底）。
# 由 ingest_attendance_policies.py 的 record_document_scope() 累积写入、
# 由 ingest_attendance_csv.py 读取 ⇒ **每次跑制度入图都会变**，入库只会产生持续 diff。
# 文件缺失时按空登记册处理、**不报错**（见 backend/scripts/_bridge_window.py 注释）。
backend/scripts/_clause_doc_scopes.json

# 演示用年报 PDF（本机素材，约 47MB，不入库；来源与 STEP-BY-STEP 用法见 changes/Sprint7.0/demo-docs-checklist.md）
docs/annualreport/
**/output/*
*.log

# 存储抽象层根目录（开发环境本地 FS 落盘内容，绝不入库）
backend/storage/

# 系统文件
.DS_Store
Thumbs.db

# License 文件（ADR-0006 §2.2）：含 Ed25519 签名与本机机器指纹。
# 客户现场由 deployment-spec §4.2 的步骤 3 自行放入，**严禁入库**。
deploy/license/*.lic

# 例外：保留 MVP 输出目录的占位文件
!**/output/.gitkeep

# CodeBuddy 临时计划文件
.codebuddy/plans/

# 本地开发数据库（Sprint 1 SQLite 兜底，绝不入库）
*.db
*.db-journal
# 彩排 / 切片脚本的临时产物与日志（本地证据，不入库）
backend/reports/
# 运行日志：含带端口号的变体（`_uvicorn8000.out` 曾因只写 `_uvicorn.*` 而漏忽略）
backend/_uvicorn*.out
backend/_uvicorn.err
frontend/_next.out
frontend/_next.err
