# LangChain MVP 配置模板
#
# 复制为 .env 后填入真实值。.env 与 .env.* 已被仓库根目录 .gitignore 忽略
# （规则来源：CODEBUDDY.md「环境与依赖规则」「密钥管理规则」）。
# 本 MVP 为独立目录 + 独立 uv 虚拟环境，不依赖也不修改 backend/。

# ===== DeepSeek（OpenAI 兼容端点）=====
# 真实密钥只放本地 .env，绝不提交、绝不硬编码进 .py
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 末尾不要带 /chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 知识图谱数据源（默认 ../bridge_web_demo/output.json）=====
# KG_OUTPUT_JSON=../bridge_web_demo/output.json

# 环境标识（默认 development）
APP_ENV=development
