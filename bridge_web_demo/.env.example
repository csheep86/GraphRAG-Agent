# Bridge Pipeline MVP 配置模板
# 复制为 .env 后填入真实值。.env 与 .env.* 已被仓库根目录 .gitignore 忽略
# （规则来源：CODEBUDDY.md「环境与依赖规则」「密钥管理规则」）。
# 说明：本 MVP 为独立目录 + 独立 uv 虚拟环境，不依赖 backend/。

# ===== LangExtract + DeepSeek（OpenAI 兼容端点）=====
# 真实密钥只放本地 .env，绝不提交
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 末尾不要带 /chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== MinerU 云服务（可选用：网页上传 PDF 时需要）=====
MINERU_TOKEN=sk-your-mineru-token-here
MINERU_API_BASE=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch

# ===== 可选：覆盖 MinerU 输出根目录（默认 ../mineru_mvp/output）=====
# MINERU_OUTPUT_DIR=../mineru_mvp/output

# 环境标识（默认 development）
APP_ENV=development
